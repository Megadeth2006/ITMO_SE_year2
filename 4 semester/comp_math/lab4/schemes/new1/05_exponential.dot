digraph G {
rankdir=TB;
graph [fontname="DejaVu Sans", bgcolor="white", dpi=180, nodesep=0.45, ranksep=0.55, splines=ortho];
node [fontname="DejaVu Sans", fontsize=12, shape=rectangle, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, margin="0.10,0.07"];
edge [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowsize=0.7];

start [shape=ellipse, label="Начало"];
in [shape=parallelogram, label="Ввод: xs, ys"];
check [shape=diamond, label="Все y_i > 0?"];
err [shape=parallelogram, label="ValueError:\nэкспоненциальная функция неприменима"];
tr [label="transformedY_i = ln(y_i)"];
coef [label="c0, c1 = least_squares_by_basis\n(xs, transformedY, [1, x])"];
ab [label="a = exp(c0)\nb = c1"];
eval [label="Создать evaluator(x):\na * exp(b * x)"];
out [shape=parallelogram, label="Вернуть FittedFunction\n'a*e^(b*x)', {a, b}, evaluator"];
end [shape=ellipse, label="Конец"];
start -> in -> check;
check -> err [label="нет"];
err -> end;
check -> tr [label="да"];
tr -> coef -> ab -> eval -> out -> end;

}
