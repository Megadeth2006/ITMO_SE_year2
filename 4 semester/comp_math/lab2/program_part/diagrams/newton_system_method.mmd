flowchart TD
    A([Начало]) --> B["Ввод: F1(x,y), F2(x,y), x0, y0, epsilon"]
    B --> C["iteration = 0"]
    C --> D["iteration = iteration + 1<br/>Вычислить матрицу Якоби J(x0, y0)"]
    D --> E["Вычислить правую часть:<br/>b1 = -F1(x0, y0)<br/>b2 = -F2(x0, y0)"]
    E --> F["Решить систему J * [dx, dy] = [b1, b2]"]
    F --> G["x1 = x0 + dx<br/>y1 = y0 + dy"]
    G --> H["diff_x = |dx|<br/>diff_y = |dy|<br/>res1 = |F1(x1, y1)|<br/>res2 = |F2(x1, y1)|"]
    H --> I{"max(diff_x, diff_y,<br/>res1, res2) < epsilon?"}
    I -- да --> J["Вывод результата"]
    J --> K([Конец])
    I -- нет --> L["x0 = x1<br/>y0 = y1"]
    L --> D
