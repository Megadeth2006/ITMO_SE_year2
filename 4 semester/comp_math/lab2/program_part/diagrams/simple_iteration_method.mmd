flowchart TD
    A([Начало]) --> B["Ввод: f(x), a, b, epsilon"]
    B --> C["Проверить, что на интервале один корень"]
    C --> D{"Интервал корректен?"}
    D -- нет --> E([Выход])
    D -- да --> F["Подобрать lambda"]
    F --> G["Вычислить q = max |1 - lambda * f'(x)|"]
    G --> H{"q < 1?"}
    H -- нет --> I([Выход])
    H -- да --> J["Выбрать начальное приближение x0"]
    J --> K["iteration = 0"]
    K --> L["iteration = iteration + 1<br/>x1 = x0 - lambda * f(x0)"]
    L --> M["diff = |x1 - x0|<br/>res = |f(x1)|"]
    M --> N{"diff < epsilon<br/>и res < epsilon?"}
    N -- да --> O["Вывод результата"]
    O --> P([Конец])
    N -- нет --> Q["x0 = x1"]
    Q --> L
