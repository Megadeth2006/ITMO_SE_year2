<!-- 
  Sample Oracle DataSource configuration for WildFly
  
  To configure Oracle DataSource in WildFly:
  
  1. Download Oracle JDBC driver (ojdbc8.jar)
  
  2. Add Oracle driver module:
     - Create directory: $WILDFLY_HOME/modules/system/layers/base/com/oracle/main/
     - Copy ojdbc8.jar to this directory
     - Create module.xml in the same directory with the following content:
     
     <?xml version="1.0" encoding="UTF-8"?>
     <module xmlns="urn:jboss:module:1.3" name="com.oracle">
         <resources>
             <resource-root path="ojdbc8.jar"/>
         </resources>
         <dependencies>
             <module name="javax.api"/>
             <module name="javax.transaction.api"/>
         </dependencies>
     </module>
  
  3. Add driver and datasource to standalone.xml or standalone-full.xml:
     Find the <datasources> section and add:
-->

<!-- Add this inside <drivers> section -->
<driver name="oracle" module="com.oracle">
    <driver-class>oracle.jdbc.OracleDriver</driver-class>
</driver>

<!-- Add this inside <datasources> section -->
<datasource jndi-name="java:jboss/datasources/OracleDS" 
            pool-name="OracleDS" 
            enabled="true" 
            use-java-context="true">
    <connection-url>jdbc:oracle:thin:@localhost:1521:XE</connection-url>
    <driver>oracle</driver>
    <security>
        <user-name>your_username</user-name>
        <password>your_password</password>
    </security>
    <validation>
        <valid-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.oracle.OracleValidConnectionChecker"/>
        <stale-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.oracle.OracleStaleConnectionChecker"/>
        <exception-sorter class-name="org.jboss.jca.adapters.jdbc.extensions.oracle.OracleExceptionSorter"/>
    </validation>
</datasource>

<!--
  For local development, you can use Oracle XE (Express Edition):
  - Download from: https://www.oracle.com/database/technologies/xe-downloads.html
  - Default connection: jdbc:oracle:thin:@localhost:1521:XE
  - Default credentials: system/oracle
  
  Alternative: Use H2 database for testing (already included in WildFly):
  - Change jta-data-source in persistence.xml to: java:jboss/datasources/ExampleDS
  - Change hibernate.dialect to: org.hibernate.dialect.H2Dialect
-->
